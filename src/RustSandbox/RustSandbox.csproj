<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RustSandbox</RootNamespace>
    <AssemblyName>RustSandbox</AssemblyName>
    <Version>1.4.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <!-- The Oxide/Carbon telemetry plugin ships inside the app so it can be
       downloaded from the UI or installed into a locally managed server. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\plugins\RustSandboxTelemetry.cs" LogicalName="RustSandboxTelemetry.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxTweaks.cs" LogicalName="RustSandboxTweaks.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxEventHud.cs" LogicalName="RustSandboxEventHud.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxSkills.cs" LogicalName="RustSandboxSkills.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxDaily.cs" LogicalName="RustSandboxDaily.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxEvents.cs" LogicalName="RustSandboxEvents.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxQuests.cs" LogicalName="RustSandboxQuests.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxHelp.cs" LogicalName="RustSandboxHelp.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxRecycler.cs" LogicalName="RustSandboxRecycler.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxSkins.cs" LogicalName="RustSandboxSkins.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxLoot.cs" LogicalName="RustSandboxLoot.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxPet.cs" LogicalName="RustSandboxPet.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxWeather.cs" LogicalName="RustSandboxWeather.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxNpcs.cs" LogicalName="RustSandboxNpcs.cs" />
    <EmbeddedResource Include="..\..\plugins\RustSandboxStore.cs" LogicalName="RustSandboxStore.cs" />
  </ItemGroup>

  <!-- Maps that ship with the app (Maui is the default map). The manager hosts them for Rust to download. -->
  <ItemGroup>
    <Content Include="..\..\maps\**\*.map;..\..\maps\**\*.jpg;..\..\maps\**\*.png;..\..\maps\**\*.json" LinkBase="maps" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
