@page "/s/{Id:int}/quests"
@inherits ServerPageBase
@inject QuestsService QuestsApi
@inject TweaksService Tweaks
@using System.Globalization
@using System.Text.Json.Nodes
@using System.Text.RegularExpressions

<PageTitle>@(Server?.Name ?? "Server") · Quests</PageTitle>

@if (Server is not null)
{
    <div class="page">
        <div class="page-head">
            <div class="grow">
                <h1>Quests</h1>
                <p>Place quest givers around the map. Players press <kbd>E</kbd> on one to pick a quest, follow it on the tracker, and hand it in for the rewards you choose. <code>/quests</code> opens their quest log and <code>/quests list</code> says where every quest giver and quest location is.</p>
            </div>
            @if (_summary is not null)
            {
                <span class="badge good">Plugin v@(_summary.Version)</span>
            }
            else if (Runtime.IsOnline && _loaded)
            {
                <span class="badge warn">Plugin not loaded</span>
            }
            <button class="btn" @onclick="RefreshAsync" disabled="@_busy">Refresh</button>
        </div>

        @if (Runtime.IsOnline && _summary is null && _loaded)
        {
            <div class="callout warn" style="margin-bottom:var(--gap)">The Quests plugin didn't answer. Install it from <a href="s/@Id/telemetry">Telemetry → Quests</a>, then refresh.</div>
        }

        <div class="duel" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr));margin-bottom:var(--gap)">
            <div><span class="muted">Quests</span><b>@QuestList().Count(q => Bool(q, QuestsService.EnabledKey, true)) <span class="muted" style="font-size:14px">enabled</span></b></div>
            <div><span class="muted">Quest givers</span><b>@(_summary?.Givers.Count(g => g.ThisMap).ToString() ?? "—")</b></div>
            <div><span class="muted">In progress</span><b>@(_summary?.Players.Sum(p => p.Active.Count).ToString() ?? "—")</b></div>
            <div><span class="muted">Completed</span><b>@(_summary?.Players.Sum(p => p.Done.Sum(d => d.Count)).ToString() ?? "—")</b></div>
        </div>

        <div class="tabs" role="tablist">
            <button role="tab" class="@(_tab == "quests" ? "on" : "")" @onclick='() => _tab = "quests"'>Quests</button>
            <button role="tab" class="@(_tab == "givers" ? "on" : "")" @onclick='() => _tab = "givers"'>Quest givers</button>
            <button role="tab" class="@(_tab == "players" ? "on" : "")" @onclick='() => _tab = "players"'>Players &amp; history</button>
        </div>

        @if (_tab == "quests")
        {
            @if (_configError is not null)
            {
                <div class="callout warn">@_configError</div>
            }
            else if (_config is not null)
            {
                <div class="row" style="margin-bottom:var(--gap)">
                    <p class="muted" style="margin:0;flex:1">Pick what each quest asks for and what it pays. Saving reloads the plugin; players keep their progress.</p>
                    @if (_dirty)
                    {
                        <button class="btn ghost" @onclick="LoadConfigAsync" disabled="@_busy">Discard</button>
                    }
                    <button class="btn primary" @onclick="SaveAsync" disabled="@(_busy || !_dirty)"><Icon Name="save" /> Save &amp; reload</button>
                </div>

                <section class="panel" style="margin-bottom:var(--gap)">
                    <div class="panel-head"><h2>Settings</h2></div>
                    <div class="panel-body form-grid">
                        <label class="field">
                            <span>Max active quests per player</span>
                            <input class="input" type="number" min="1" max="10" step="1" value="@F(Num(_config, MaxActiveKey))" @onchange="e => SetInt(_config, MaxActiveKey, e)" />
                        </label>
                        <label class="field">
                            <span>New quest givers look like</span>
                            <select class="input" value="@Str(_config, DefaultLookKey)" @onchange="e => SetStr(_config, DefaultLookKey, e)">
                                @foreach (var l in Looks)
                                {
                                    <option value="@l">@QuestsService.LookLabel(l)</option>
                                }
                            </select>
                        </label>
                        <label class="check wide">
                            <input type="checkbox" checked="@Bool(_config, ReturnKey)" @onchange="e => SetBool(_config, ReturnKey, e)" />
                            <span><b>Return to a quest giver to claim rewards</b><small>Off: rewards go straight into the inventory when a quest is done.</small></span>
                        </label>
                        <label class="check wide">
                            <input type="checkbox" checked="@Bool(_config, TrackerKey)" @onchange="e => SetBool(_config, TrackerKey, e)" />
                            <span><b>Show the quest tracker</b><small>Active quests with progress bars on the right of the screen. Players can hide it from their quest log.</small></span>
                        </label>
                        <label class="check wide">
                            <input type="checkbox" checked="@Bool(_config, MarkGiversKey, true)" @onchange="e => SetBool(_config, MarkGiversKey, e)" />
                            <span><b>Show quest givers on the map</b><small>Pick how they look below.</small></span>
                        </label>
                        <label class="field">
                            <span>Quest giver map marker</span>
                            <select class="input" style="min-width:470px" value="@(Str(_config, MarkerStyleKey) is "Pin" ? "Pin" : "Hover")" @onchange="e => SetStr(_config, MarkerStyleKey, e)" disabled="@(!Bool(_config, MarkGiversKey, true))">
                                <option value="Hover">Small icon, name on hover, plus green ? (new quest) and yellow ! (hand in) pins</option>
                                <option value="Pin">Labelled pin on every quest giver, with green ? and yellow !</option>
                            </select>
                        </label>
                        <label class="check wide">
                            <input type="checkbox" checked="@Bool(_config, MarkQuestsKey, true)" @onchange="e => SetBool(_config, MarkQuestsKey, e)" />
                            <span><b>Mark active quest locations on the map and compass</b><small>Explore quests and quests limited to a monument put a marker on that monument until they're done.</small></span>
                        </label>
                        <label class="check wide">
                            <input type="checkbox" checked="@Bool(_config, AnnounceKey)" @onchange="e => SetBool(_config, AnnounceKey, e)" />
                            <span><b>Announce completed quests in chat</b></span>
                        </label>
                        <label class="check wide">
                            <input type="checkbox" checked="@Bool(_config, WipeKey)" @onchange="e => SetBool(_config, WipeKey, e)" />
                            <span><b>Reset quest progress on map wipe</b></span>
                        </label>
                    </div>
                </section>

                @foreach (var q in QuestList())
                {
                    var qid = Str(q, QuestsService.IdKey);
                    var type = Str(q, QuestsService.TypeKey);
                    var open = _open.Contains(qid);
                    var enabled = Bool(q, QuestsService.EnabledKey, true);
                    var rewards = Rewards(q);
                    var problem = Problem(q);
                    EnsureRow(qid);
                    <section class="panel quest-card @(enabled ? "" : "off")" style="margin-bottom:10px">
                        <div class="panel-head quest-head" @onclick="() => Toggle(qid)">
                            <span class="badge @TypeBadge(type)">@TypeLabel(type)</span>
                            <div class="grow" style="min-width:0">
                                <div class="ellipsis" style="font-weight:600">@Str(q, QuestsService.TitleKey)</div>
                                <div class="muted ellipsis" style="font-size:13px">@ObjectiveOf(q)@(GiverLabel(q) is { } gl ? $" · {gl}" : "")</div>
                            </div>
                            @if (problem is not null)
                            {
                                <span class="badge warn">@problem</span>
                            }
                            <span class="reward-icons">
                                @foreach (var r in rewards.Take(4))
                                {
                                    <img src="api/servers/@Id/item-icon/@Str(r, RItem)" alt="" width="26" height="26" loading="lazy" title="@F(Num(r, RAmount))× @NameOf(Str(r, RItem))" onerror="this.style.visibility='hidden'" />
                                }
                                @if (rewards.Count > 4)
                                {
                                    <span class="muted" style="font-size:12px">+@(rewards.Count - 4)</span>
                                }
                            </span>
                            @if (CompletionsOf(qid) is > 0 and var n)
                            {
                                <span class="hint" title="Times completed">✓ @n</span>
                            }
                            <span class="muted" style="width:16px;text-align:center">@(open ? "▾" : "▸")</span>
                        </div>
                        @if (open)
                        {
                            <div class="panel-body">
                                <div class="form-grid">
                                    <label class="field">
                                        <span>Title</span>
                                        <input class="input" value="@Str(q, QuestsService.TitleKey)" @onchange="e => SetTitle(q, e)" />
                                    </label>
                                    <label class="field">
                                        <span>Type</span>
                                        <select class="input" value="@type" @onchange="e => SetType(q, e)">
                                            @foreach (var t in QuestsService.Types)
                                            {
                                                <option value="@t">@TypeLabel(t) · @TypeHelp(t)</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="field">
                                        <span>Offered by</span>
                                        <select class="input" value="@Str(q, QuestsService.GiverKey)" @onchange="e => SetStr(q, QuestsService.GiverKey, e)">
                                            <option value="">Every quest giver</option>
                                            @foreach (var g in GiverOptions(Str(q, QuestsService.GiverKey)))
                                            {
                                                <option value="@g.Id">@g.Label</option>
                                            }
                                        </select>
                                    </label>

                                    @switch (type)
                                    {
                                        case "Kill":
                                        case "Loot":
                                            var presets = type == "Kill" ? QuestsService.KillPresets : QuestsService.LootPresets;
                                            var target = Str(q, QuestsService.TargetKey);
                                            var preset = presets.FirstOrDefault(p => p.Target == target).Target;
                                            <label class="field">
                                                <span>@(type == "Kill" ? "What to kill" : "What to loot")</span>
                                                <select class="input" value="@(preset ?? "custom")" @onchange="e => SetPreset(q, e)">
                                                    @foreach (var p in presets)
                                                    {
                                                        <option value="@p.Target">@p.Label</option>
                                                    }
                                                    <option value="custom">Custom prefab names…</option>
                                                </select>
                                            </label>
                                            @if (preset is null)
                                            {
                                                <label class="field">
                                                    <span>Prefab short names (comma separated, * wildcard)</span>
                                                    <input class="input" value="@target" placeholder="@(type == "Kill" ? "e.g. scientistnpc_heavy" : "e.g. crate_elite")" @onchange="e => SetStr(q, QuestsService.TargetKey, e)" />
                                                </label>
                                            }
                                            break;
                                        case "Swipe":
                                            <div class="field">
                                                <span>Keycard</span>
                                                <div class="seg">
                                                    @foreach (var c in new[] { "green", "blue", "red", "any" })
                                                    {
                                                        var colour = c;
                                                        <button class="@(Str(q, QuestsService.TargetKey).Equals(colour, StringComparison.OrdinalIgnoreCase) ? "on" : "")" @onclick="() => Set(q, QuestsService.TargetKey, colour)">@(char.ToUpper(colour[0]) + colour[1..])</button>
                                                    }
                                                </div>
                                            </div>
                                            break;
                                        case "Visit":
                                            <label class="field">
                                                <span>Monument to visit</span>
                                                <input class="input" list="quest-monuments" value="@Str(q, QuestsService.TargetKey)" placeholder="e.g. Airfield" @onchange="e => SetStr(q, QuestsService.TargetKey, e)" />
                                            </label>
                                            break;
                                        default:
                                            var item = Str(q, QuestsService.TargetKey);
                                            <label class="field">
                                                <span>@(type == "Craft" ? "Item to craft" : type == "Deliver" ? "Item to bring" : "Resource to gather")</span>
                                                <span class="item-cell">
                                                    <img class="item-icon" src="api/servers/@Id/item-icon/@(item.Split(',')[0].Trim())" alt="" width="32" height="32" loading="lazy" onerror="this.style.visibility='hidden'" />
                                                    <input class="input" list="quest-items" value="@item" placeholder="type a name or shortname" @onchange="e => SetItemTarget(q, e)" />
                                                </span>
                                            </label>
                                            break;
                                    }

                                    <label class="field">
                                        <span>@AmountLabel(type)</span>
                                        <input class="input" type="number" min="1" step="1" value="@F(Num(q, QuestsService.AmountKey))" @onchange="e => SetInt(q, QuestsService.AmountKey, e)" />
                                    </label>
                                    @if (type is "Gather" or "Kill" or "Loot" or "Swipe")
                                    {
                                        <label class="field">
                                            <span>Only at (monument)</span>
                                            <input class="input" list="quest-monuments" value="@Str(q, QuestsService.WhereKey)" placeholder="Anywhere" @onchange="e => SetStr(q, QuestsService.WhereKey, e)" />
                                        </label>
                                    }
                                    <label class="field">
                                        <span>Unlocks after</span>
                                        <select class="input" value="@Str(q, QuestsService.RequiresKey)" @onchange="e => SetStr(q, QuestsService.RequiresKey, e)">
                                            <option value="">Always available</option>
                                            @foreach (var other in QuestList().Where(o => o != q))
                                            {
                                                <option value="@Str(other, QuestsService.IdKey)">@Str(other, QuestsService.TitleKey)</option>
                                            }
                                        </select>
                                    </label>
                                    <div class="field">
                                        <span>Repeat</span>
                                        <div class="row" style="gap:8px;flex-wrap:nowrap">
                                            <label class="check" style="margin:0"><input type="checkbox" checked="@Bool(q, QuestsService.RepeatableKey)" @onchange="e => SetBool(q, QuestsService.RepeatableKey, e)" /><span>Repeatable</span></label>
                                            @if (Bool(q, QuestsService.RepeatableKey))
                                            {
                                                <span class="muted" style="font-size:13px">every</span>
                                                <input class="input" style="width:80px" type="number" min="0" step="1" value="@F(Num(q, QuestsService.CooldownKey))" @onchange="e => SetNum(q, QuestsService.CooldownKey, e)" />
                                                <span class="muted" style="font-size:13px">min</span>
                                            }
                                        </div>
                                    </div>
                                    <label class="field wide">
                                        <span>What the quest giver says</span>
                                        <textarea class="input" rows="2" @onchange="e => SetStr(q, QuestsService.DescriptionKey, e)">@Str(q, QuestsService.DescriptionKey)</textarea>
                                    </label>
                                    <label class="field wide">
                                        <span>Objective text <span class="muted">(blank = automatic)</span></span>
                                        <input class="input" value="@Str(q, QuestsService.ObjectiveKey)" placeholder="@AutoObjective(q)" @onchange="e => SetStr(q, QuestsService.ObjectiveKey, e)" />
                                    </label>
                                </div>

                                <h3 style="font-size:15px;margin:18px 0 8px">Rewards</h3>
                                <div class="table-wrap">
                                    <table class="table">
                                        <thead><tr><th>Item</th><th style="width:140px">Amount</th><th style="width:44px"></th></tr></thead>
                                        <tbody>
                                            @foreach (var r in rewards)
                                            {
                                                var shortName = Str(r, RItem);
                                                <tr>
                                                    <td>
                                                        <span class="item-cell">
                                                            <img class="item-icon" src="api/servers/@Id/item-icon/@shortName" alt="" width="32" height="32" loading="lazy" onerror="this.style.visibility='hidden'" />
                                                            <span>@NameOf(shortName) <span class="muted" style="font-size:12px">@shortName</span>@if (!Known(shortName)) {<span class="badge warn" style="margin-left:6px">unknown item</span>}</span>
                                                        </span>
                                                    </td>
                                                    <td><input class="input" type="number" min="1" step="1" value="@F(Num(r, RAmount))" @onchange="e => SetInt(r, RAmount, e)" /></td>
                                                    <td><button class="btn sm ghost" title="Remove" @onclick="() => RemoveReward(q, r)"><Icon Name="trash" /></button></td>
                                                </tr>
                                            }
                                            <tr>
                                                <td colspan="3">
                                                    <div class="row" style="gap:6px">
                                                        <input class="input" style="width:260px" list="quest-items" placeholder="Add an item: type a name or shortname" @bind="_newReward[qid]" />
                                                        <input class="input" style="width:100px" type="number" min="1" step="1" @bind="_newAmount[qid]" />
                                                        <button class="btn sm" @onclick="() => AddReward(q)">Add</button>
                                                        <button class="btn sm primary" title="Pick from pictures of every item" @onclick="() => _galleryFor = q">Browse items</button>
                                                        <span class="spacer" style="flex:1"></span>
                                                        @foreach (var quick in QuickRewards)
                                                        {
                                                            var qr = quick;
                                                            <button class="btn sm ghost" title="Add @qr.Amount× @NameOf(qr.Item)" @onclick="() => AddReward(q, qr.Item, qr.Amount)">+@qr.Amount @NameOf(qr.Item)</button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <details style="margin-top:12px">
                                    <summary class="muted" style="cursor:pointer">Advanced: console commands on completion</summary>
                                    <p class="help">One per line, run as the server. <code>{steamid}</code> and <code>{name}</code> are replaced with the player's. For example <code>oxide.usergroup add {steamid} vip</code>.</p>
                                    <textarea class="input" rows="3" style="width:100%;font-family:var(--font-mono)" @onchange="e => SetCommands(q, e)">@string.Join("\n", Commands(q))</textarea>
                                </details>

                                <div class="row" style="margin-top:14px">
                                    <label class="check" style="margin:0"><input type="checkbox" checked="@enabled" @onchange="e => SetBool(q, QuestsService.EnabledKey, e)" /><span>Enabled</span></label>
                                    <span class="muted" style="font-size:12px">id: @qid</span>
                                    <span class="spacer" style="flex:1"></span>
                                    <button class="btn sm" @onclick="() => Duplicate(q)">Duplicate</button>
                                    <button class="btn sm danger" @onclick="() => RemoveQuest(q)"><Icon Name="trash" /> Delete</button>
                                </div>
                            </div>
                        }
                    </section>
                }
                <div class="row" style="margin-top:6px">
                    <span class="muted">Add a quest:</span>
                    @foreach (var t in QuestsService.Types)
                    {
                        var tt = t;
                        <button class="btn sm" @onclick="() => AddQuest(tt)"><Icon Name="plus" /> @TypeLabel(tt)</button>
                    }
                </div>

                <datalist id="quest-items">
                    @foreach (var i in _items)
                    {
                        <option value="@i.Short">@i.Name</option>
                    }
                </datalist>
                <datalist id="quest-monuments">
                    @foreach (var m in QuestsService.Monuments)
                    {
                        <option value="@m"></option>
                    }
                </datalist>
            }
        }
        else if (_tab == "givers")
        {
            @if (!Runtime.IsOnline)
            {
                <div class="callout warn">Quest givers are placed in the game, so start the server to manage them. You can still edit quests on the Quests tab.</div>
            }
            else if (_summary is not null)
            {
                <section class="panel" style="margin-bottom:var(--gap)">
                    <div class="panel-head"><h2>Place a quest giver</h2></div>
                    <div class="panel-body">
                        <p class="muted" style="margin-top:0">Pick a name from the list (or type your own) and how they look, then choose whose position to place them at. The quest giver appears where that player is standing, facing them. In game, admins can also type <code>/questgiver add Name</code>.</p>
                        <div class="row">
                            <select class="input" style="width:200px" value="" @onchange="PickName">
                                <option value="">Pick a name…</option>
                                @foreach (var n in FreeNames())
                                {
                                    <option value="@n">@n</option>
                                }
                            </select>
                            <input class="input" style="width:200px" placeholder="Name, e.g. Old Pete" @bind="_giverName" />
                            <button class="btn sm" title="Random name" @onclick="RandomName">Random</button>
                            <select class="input" style="width:150px" title="How they look" @bind="_placeLook">
                                <option value="">Default look</option>
                                @foreach (var l in Looks)
                                {
                                    <option value="@l">@QuestsService.LookLabel(l)</option>
                                }
                            </select>
                            <select class="input" style="width:220px" @bind="_placeAt">
                                @if (Runtime.Players.Count == 0)
                                {
                                    <option value="">Nobody is online</option>
                                }
                                @foreach (var p in Runtime.Players)
                                {
                                    <option value="@p.SteamId">At @p.Name's position</option>
                                }
                            </select>
                            <button class="btn primary" @onclick="PlaceAsync" disabled="@(_busy || Runtime.Players.Count == 0)"><Icon Name="plus" /> Place quest giver</button>
                        </div>
                    </div>
                </section>

                <section class="panel">
                    <div class="panel-head"><h2>Quest givers</h2><span class="spacer"></span><span class="hint">@_summary.Givers.Count placed</span></div>
                    <div class="panel-body flush table-wrap">
                        @if (_summary.Givers.Count == 0)
                        {
                            <div class="empty">No quest givers yet. Place one above, then walk up to it in game and press E.</div>
                        }
                        else
                        {
                            <table class="table">
                                <thead><tr><th>Name</th><th>Look</th><th>Where</th><th>Quests</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var g in _summary.Givers)
                                    {
                                        var giver = g;
                                        <tr>
                                            <td>
                                                <input class="input" style="width:180px" value="@giver.Name" @onchange="e => RenameAsync(giver, e)" />
                                                <span class="muted" style="font-size:12px;margin-left:6px">@giver.Id</span>
                                            </td>
                                            <td>
                                                <select class="input" style="width:150px" value="@giver.Look" @onchange="e => LookAsync(giver, e)">
                                                    @foreach (var l in Looks)
                                                    {
                                                        <option value="@l">@QuestsService.LookLabel(l)</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                @if (giver.ThisMap)
                                                {
                                                    <b>@giver.Grid</b> <span class="muted" style="font-size:12px">@giver.X.ToString("0", CultureInfo.InvariantCulture), @giver.Z.ToString("0", CultureInfo.InvariantCulture)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge warn" title="Placed on a different map; hidden until that map is back">Another map</span>
                                                }
                                            </td>
                                            <td>@OfferedBy(giver.Id)</td>
                                            <td class="r" style="white-space:nowrap">
                                                <button class="btn sm" title="Move to the selected player's position" @onclick="() => MoveAsync(giver)" disabled="@(_busy || string.IsNullOrEmpty(_placeAt))">Move here</button>
                                                <button class="btn sm danger" title="Remove" @onclick="() => _removeGiver = giver"><Icon Name="trash" /></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </section>
            }
        }
        else if (_tab == "players")
        {
            <div class="grid" style="grid-template-columns:minmax(0,1fr) minmax(260px,380px)">
                <section class="panel">
                    <div class="panel-head"><h2>Players</h2></div>
                    <div class="panel-body flush table-wrap">
                        @if (_summary is null || _summary.Players.Count == 0)
                        {
                            <div class="empty">@(_summary is null ? (Runtime.IsOnline ? "No data from the plugin." : "Start the server to see players' quests.") : "Nobody has taken a quest yet.")</div>
                        }
                        else
                        {
                            <table class="table">
                                <thead><tr><th>Player</th><th>In progress</th><th class="r">Done</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var p in _summary.Players.OrderByDescending(p => p.Online).ThenByDescending(p => p.Done.Sum(d => d.Count)))
                                    {
                                        var player = p;
                                        <tr>
                                            <td class="ellipsis" style="max-width:180px">@if (player.Online) {<span class="online-dot" title="Online"></span>}@player.Name</td>
                                            <td>
                                                @if (player.Active.Count == 0)
                                                {
                                                    <span class="muted">—</span>
                                                }
                                                <div class="barlist">
                                                    @foreach (var a in player.Active)
                                                    {
                                                        var pct = a.Goal > 0 ? Math.Min(100, a.Progress * 100 / a.Goal) : 0;
                                                        <div class="bar-row">
                                                            <span class="name">@a.Title</span>
                                                            <span class="bar-track"><span class="bar-fill" style="width:@(a.Complete ? 100 : pct)%;@(a.Complete ? "background:var(--patina)" : "")"></span></span>
                                                            <span class="v">@(a.Complete ? "Ready" : $"{a.Progress:N0}/{a.Goal:N0}")</span>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td class="r num" title="@string.Join(", ", player.Done.Select(d => $"{TitleOf(d.Quest)} ×{d.Count}"))">@player.Done.Sum(d => d.Count)</td>
                                            <td class="r"><button class="btn sm ghost" title="Clear this player's quest progress" @onclick="() => _resetPlayer = player">Reset</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </section>
                <section class="panel">
                    <div class="panel-head"><h2>Recently completed</h2></div>
                    <div class="panel-body flush">
                        @if (_summary is null || _summary.History.Count == 0)
                        {
                            <div class="empty">No quests completed yet.</div>
                        }
                        else
                        {
                            <table class="table">
                                <tbody>
                                    @foreach (var h in _summary.History.Take(50))
                                    {
                                        <tr>
                                            <td class="muted" title="@h.At.ToLocalTime().ToString("g")">@Fmt.Ago(h.At)</td>
                                            <td class="ellipsis" style="max-width:120px">@h.Name</td>
                                            <td class="ellipsis" style="max-width:160px">@h.Title</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </section>
            </div>
        }
    </div>

    <ItemGallery Visible="@(_galleryFor is not null)" VisibleChanged="v => { if (!v) _galleryFor = null; }" ServerId="@Id" Items="@_items"
                 Title="Choose a reward" OnPick="s => { if (_galleryFor is { } gq) AddReward(gq, s); }" />

    <ConfirmDialog Visible="@(_removeGiver is not null)" VisibleChanged="v => { if (!v) _removeGiver = null; }" Title="Remove this quest giver?" ConfirmText="Remove" Danger="true" OnConfirm="RemoveGiverAsync">
        <p>@_removeGiver?.Name disappears from the map. Quests that only they offer stay in the list but nobody can pick them up until you give them to another quest giver.</p>
    </ConfirmDialog>
    <ConfirmDialog Visible="@(_resetPlayer is not null)" VisibleChanged="v => { if (!v) _resetPlayer = null; }" Title="Reset this player's quests?" ConfirmText="Reset" Danger="true" OnConfirm="ResetPlayerAsync">
        <p>@_resetPlayer?.Name loses every quest in progress and every completion, so they can do them all again.</p>
    </ConfirmDialog>
}

@code {
    private const string ReturnKey = "Return to a quest giver to claim rewards";
    private const string MaxActiveKey = "Max active quests per player";
    private const string TrackerKey = "Show the quest tracker";
    private const string AnnounceKey = "Announce quest completions to everyone";
    private const string WipeKey = "Reset quest progress on map wipe";
    private const string DefaultLookKey = "Default quest giver look";
    private const string MarkGiversKey = "Show quest givers on the map and compass";
    private const string MarkerStyleKey = "Quest giver marker style (Hover = small icon, name on hover; Pin = labelled pin with (!))";
    private const string MarkQuestsKey = "Mark active quest locations on the map and compass";
    private const string RItem = "Item";
    private const string RAmount = "Amount";

    private static readonly string[] DefaultLooks = { "outpost_a", "outpost_b", "bandit_a", "bandit_b", "fishing_a", "fishing_b", "stables_a", "stables_b", "generic_a", "floatingcity_a" };
    private static readonly (string Item, int Amount)[] QuickRewards = { ("scrap", 100), ("scrap", 500) };

    private string _tab = "quests";
    private bool _busy, _loaded, _dirty;
    private QuestsSummary? _summary;
    private JsonObject? _config;
    private string? _configError;
    private List<RustItem> _items = new();
    private Dictionary<string, RustItem> _itemsByShort = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _open = new();
    private readonly HashSet<string> _fresh = new();
    private readonly Dictionary<string, string> _newReward = new();
    private readonly Dictionary<string, int> _newAmount = new();
    private string _giverName = "";
    private string _placeLook = "";
    private JsonObject? _galleryFor;
    private string _placeAt = "";
    private QuestGiverInfo? _removeGiver;
    private QuestPlayer? _resetPlayer;

    private IReadOnlyList<string> Looks => _summary?.Looks is { Count: > 0 } l ? l : DefaultLooks;

    protected override async Task OnServerChangedAsync()
    {
        await RefreshAsync();
        await LoadConfigAsync();
        if (Server is not null)
        {
            (_items, _) = await Tweaks.GetItemsAsync(Server);
            _itemsByShort = _items.GroupBy(i => i.Short, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task RefreshAsync()
    {
        _busy = true;
        try
        {
            _summary = Runtime.IsOnline ? await QuestsApi.SummaryAsync(Id, 100) : null;
            _loaded = true;
            if (string.IsNullOrEmpty(_placeAt) || Runtime.Players.All(p => p.SteamId != _placeAt))
                _placeAt = Runtime.Players.FirstOrDefault()?.SteamId ?? "";
        }
        finally { _busy = false; }
    }

    private async Task LoadConfigAsync()
    {
        if (Server is null) return;
        (_config, _configError) = await QuestsService.ReadConfigAsync(Server);
        _dirty = false;
        _fresh.Clear();
    }

    private async Task SaveAsync()
    {
        if (Server is null || _config is null) return;
        _busy = true;
        try
        {
            var err = await QuestsApi.SaveConfigAsync(Server, _config);
            if (err is not null) { Toasts.Error(err); return; }
            Toasts.Success(Runtime.IsOnline ? "Saved — the plugin reloaded with your quests." : "Saved. It applies the next time the server starts.");
            await LoadConfigAsync();
            await RefreshAsync();
        }
        finally { _busy = false; }
    }

    // ---- quest givers (live, over RCON)

    private async Task Run(Func<Task<string?>> action, string? success = null)
    {
        _busy = true;
        try
        {
            var reply = await action();
            if (reply is null) Toasts.Error("The server didn't answer.");
            else Toasts.Show(success ?? reply.Trim());
            await RefreshAsync();
        }
        finally { _busy = false; }
    }

    private async Task PlaceAsync()
    {
        var name = string.IsNullOrWhiteSpace(_giverName) ? "Quest Giver" : _giverName.Trim();
        var look = _placeLook;
        var before = (_summary?.Givers ?? new()).Select(g => g.Id).ToHashSet();
        _giverName = "";
        await Run(() => QuestsApi.AddGiverAsync(Id, _placeAt, name));
        // The plugin places new givers in the default look; switch the new one to the look picked here.
        if (look.Length > 0 && _summary?.Givers.FirstOrDefault(g => !before.Contains(g.Id)) is { } added && added.Look != look)
            await Run(() => QuestsApi.SetLookAsync(Id, added.Id, look));
    }

    private static readonly string[] SuggestedNames =
    {
        "Old Pete", "Rusty Joe", "Scrap Sally", "Hazmat Hank", "Doc Bandage", "Big Mike", "Captain Tide", "Granny Mae",
        "Sergeant Stone", "Tin Can Tom", "Mad Maxine", "Sulfur Sam", "Fisherman Fred", "Ranger Rae", "Professor Bolt", "Lucky Lou",
        "Smokey", "The Trader", "Ironside", "Whisper", "Junkyard Jim", "Outpost Olly", "Bandit Bob", "Nurse Nora",
        "Mechanic Mo", "Keycard Kate", "Hunter Hugo", "Stash Steve", "Boom Boom Betty", "Lighthouse Larry",
    };

    private IEnumerable<string> FreeNames()
    {
        var used = (_summary?.Givers ?? new()).Select(g => g.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return SuggestedNames.Where(n => !used.Contains(n));
    }

    private void PickName(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } n) _giverName = n;
    }

    private void RandomName()
    {
        var free = FreeNames().ToList();
        if (free.Count > 0) _giverName = free[Random.Shared.Next(free.Count)];
    }

    private Task MoveAsync(QuestGiverInfo g) => Run(() => QuestsApi.MoveGiverAsync(Id, g.Id, _placeAt));

    private Task RenameAsync(QuestGiverInfo g, ChangeEventArgs e)
    {
        var name = e.Value?.ToString()?.Trim() ?? "";
        return name.Length == 0 || name == g.Name ? Task.CompletedTask : Run(() => QuestsApi.RenameGiverAsync(Id, g.Id, name));
    }

    private Task LookAsync(QuestGiverInfo g, ChangeEventArgs e) =>
        Run(() => QuestsApi.SetLookAsync(Id, g.Id, e.Value?.ToString() ?? ""));

    private async Task RemoveGiverAsync()
    {
        if (_removeGiver is { } g) await Run(() => QuestsApi.RemoveGiverAsync(Id, g.Id));
        _removeGiver = null;
    }

    private async Task ResetPlayerAsync()
    {
        if (_resetPlayer is { } p) await Run(() => QuestsApi.ResetAsync(Id, p.Id, null));
        _resetPlayer = null;
    }

    private string OfferedBy(string giverId)
    {
        var mine = QuestList().Count(q => string.Equals(Str(q, QuestsService.GiverKey), giverId, StringComparison.OrdinalIgnoreCase));
        var everyone = QuestList().Count(q => Str(q, QuestsService.GiverKey).Length == 0);
        return mine > 0 ? $"{mine} own + {everyone} shared" : $"{everyone} shared";
    }

    private IEnumerable<(string Id, string Label)> GiverOptions(string current)
    {
        var list = (_summary?.Givers ?? new()).Select(g => (g.Id, $"{g.Name} ({g.Grid})")).ToList();
        if (current.Length > 0 && list.All(g => g.Id != current)) list.Add((current, _summary is null ? current : $"{current} (removed)"));
        return list;
    }

    private string? GiverLabel(JsonObject q)
    {
        var id = Str(q, QuestsService.GiverKey);
        if (id.Length == 0) return null;
        return _summary?.Givers.FirstOrDefault(g => g.Id == id)?.Name ?? id;
    }

    private int CompletionsOf(string questId) =>
        _summary?.Players.Sum(p => p.Done.Where(d => d.Quest == questId).Sum(d => d.Count)) ?? 0;

    private string TitleOf(string questId) =>
        QuestList().FirstOrDefault(q => Str(q, QuestsService.IdKey) == questId) is { } q ? Str(q, QuestsService.TitleKey) : questId;

    // ---- quest config (the plugin's JSON, edited in place)

    private List<JsonObject> QuestList() =>
        (_config?[QuestsService.QuestsKey] as JsonArray)?.OfType<JsonObject>().ToList() ?? new();

    private static List<JsonObject> Rewards(JsonObject q) =>
        (q[QuestsService.RewardsKey] as JsonArray)?.OfType<JsonObject>().ToList() ?? new();

    private static List<string> Commands(JsonObject q) =>
        (q[QuestsService.CommandsKey] as JsonArray)?.Select(n => n?.ToString() ?? "").Where(s => s.Length > 0).ToList() ?? new();

    private void EnsureRow(string qid)
    {
        _newReward.TryAdd(qid, "");
        _newAmount.TryAdd(qid, 1);
    }

    private void Toggle(string id)
    {
        if (!_open.Remove(id)) _open.Add(id);
    }

    private string UniqueId(string title, JsonObject? except = null)
    {
        var slug = Regex.Replace(title.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');
        if (slug.Length == 0) slug = "quest";
        var taken = QuestList().Where(q => q != except).Select(q => Str(q, QuestsService.IdKey)).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var id = slug;
        for (var n = 2; taken.Contains(id); n++) id = $"{slug}-{n}";
        return id;
    }

    private void AddQuest(string type)
    {
        if (_config?[QuestsService.QuestsKey] is not JsonArray list)
            _config![QuestsService.QuestsKey] = list = new JsonArray();
        var id = UniqueId("new quest");
        var q = QuestsService.NewQuest(id, type);
        if (type == "Kill") q[QuestsService.TargetKey] = QuestsService.KillPresets[0].Target;
        if (type == "Loot") q[QuestsService.TargetKey] = QuestsService.LootPresets[0].Target;
        if (type == "Swipe") q[QuestsService.TargetKey] = "green";
        if (type == "Visit") q[QuestsService.TargetKey] = "Airfield";
        if (type == "Craft") q[QuestsService.TargetKey] = "spear.wooden";
        if (type == "Deliver") q[QuestsService.TargetKey] = "cloth";
        list.Add(q);
        _open.Add(id);
        _fresh.Add(id);
        _dirty = true;
    }

    private void Duplicate(JsonObject q)
    {
        if (_config?[QuestsService.QuestsKey] is not JsonArray list) return;
        var copy = (JsonObject)q.DeepClone();
        var title = Str(q, QuestsService.TitleKey) + " (copy)";
        var id = UniqueId(title);
        copy[QuestsService.TitleKey] = title;
        copy[QuestsService.IdKey] = id;
        list.Insert(list.IndexOf(q) + 1, copy);
        _open.Add(id);
        _fresh.Add(id);
        _dirty = true;
    }

    private void RemoveQuest(JsonObject q)
    {
        if (_config?[QuestsService.QuestsKey] is not JsonArray list) return;
        var id = Str(q, QuestsService.IdKey);
        list.Remove(q);
        // Anything that waited on it is unlocked.
        foreach (var other in QuestList().Where(o => Str(o, QuestsService.RequiresKey) == id)) other[QuestsService.RequiresKey] = "";
        _dirty = true;
    }

    /// <summary>A quest that hasn't been saved yet takes its id from its title; saved ids stay put so progress isn't lost.</summary>
    private void SetTitle(JsonObject q, ChangeEventArgs e)
    {
        var title = e.Value?.ToString()?.Trim() ?? "";
        q[QuestsService.TitleKey] = title;
        var oldId = Str(q, QuestsService.IdKey);
        if (_fresh.Contains(oldId) && title.Length > 0)
        {
            var id = UniqueId(title, q);
            q[QuestsService.IdKey] = id;
            _fresh.Remove(oldId);
            _fresh.Add(id);
            if (_open.Remove(oldId)) _open.Add(id);
            if (_newReward.Remove(oldId, out var r)) _newReward[id] = r;
            foreach (var other in QuestList().Where(o => Str(o, QuestsService.RequiresKey) == oldId)) other[QuestsService.RequiresKey] = id;
        }
        _dirty = true;
    }

    private void SetType(JsonObject q, ChangeEventArgs e)
    {
        var type = e.Value?.ToString() ?? "Gather";
        if (type == Str(q, QuestsService.TypeKey)) return;
        q[QuestsService.TypeKey] = type;
        q[QuestsService.TargetKey] = type switch
        {
            "Kill" => QuestsService.KillPresets[0].Target,
            "Loot" => QuestsService.LootPresets[0].Target,
            "Swipe" => "green",
            "Visit" => "Airfield",
            "Craft" => "spear.wooden",
            "Deliver" => "cloth",
            _ => "stones",
        };
        if (type is "Craft" or "Deliver" or "Visit") q[QuestsService.WhereKey] = "";
        _dirty = true;
    }

    private void SetPreset(JsonObject q, ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "";
        q[QuestsService.TargetKey] = v == "custom" ? "" : v;
        _dirty = true;
    }

    private void SetItemTarget(JsonObject q, ChangeEventArgs e) =>
        Set(q, QuestsService.TargetKey, string.Join(",", (e.Value?.ToString() ?? "").Split(',').Select(t => ShortOf(t.Trim())).Where(t => t.Length > 0)));

    private string ShortOf(string text)
    {
        if (_itemsByShort.ContainsKey(text)) return _itemsByShort[text].Short;
        return _items.FirstOrDefault(i => string.Equals(i.Name, text, StringComparison.OrdinalIgnoreCase))?.Short ?? text;
    }

    private void SetCommands(JsonObject q, ChangeEventArgs e)
    {
        var lines = (e.Value?.ToString() ?? "").Split('\n').Select(l => l.Trim()).Where(l => l.Length > 0);
        q[QuestsService.CommandsKey] = new JsonArray(lines.Select(l => (JsonNode?)JsonValue.Create(l)).ToArray());
        _dirty = true;
    }

    private void AddReward(JsonObject q, string? item = null, int amount = 0)
    {
        var qid = Str(q, QuestsService.IdKey);
        var text = item ?? (_newReward.TryGetValue(qid, out var t) ? t : "")?.Trim() ?? "";
        if (text.Length == 0) return;
        if (amount <= 0) amount = _newAmount.TryGetValue(qid, out var a) && a > 0 ? a : 1;
        var shortName = ShortOf(text);
        if (q[QuestsService.RewardsKey] is not JsonArray list) q[QuestsService.RewardsKey] = list = new JsonArray();
        // Adding the same item again tops up its amount.
        var existing = list.OfType<JsonObject>().FirstOrDefault(r => string.Equals(Str(r, RItem), shortName, StringComparison.OrdinalIgnoreCase));
        if (existing is not null) existing["Amount"] = (int)Num(existing, RAmount) + amount;
        else list.Add(new JsonObject { ["Item"] = shortName, ["Amount"] = amount, ["Skin"] = 0 });
        _newReward[qid] = "";
        _newAmount[qid] = 1;
        _dirty = true;
    }

    private void RemoveReward(JsonObject q, JsonObject r)
    {
        if (q[QuestsService.RewardsKey] is JsonArray list) list.Remove(r);
        _dirty = true;
    }

    private string? Problem(JsonObject q)
    {
        var type = Str(q, QuestsService.TypeKey);
        var target = Str(q, QuestsService.TargetKey);
        if (target.Length == 0) return "Needs a target";
        if (type is "Gather" or "Craft" or "Deliver" && _itemsByShort.Count > 0
            && target.Split(',').Select(s => s.Trim()).Any(s => s.Length > 0 && !s.Contains('*') && !_itemsByShort.ContainsKey(s)))
            return "Unknown item";
        if (Rewards(q).Count == 0 && Commands(q).Count == 0) return "No reward";
        return null;
    }

    // ---- display helpers

    private static string TypeLabel(string type) => type switch
    {
        "Gather" => "Gather",
        "Kill" => "Hunt",
        "Loot" => "Loot",
        "Craft" => "Craft",
        "Deliver" => "Deliver",
        "Swipe" => "Keycard",
        "Visit" => "Explore",
        _ => type,
    };

    private static string TypeHelp(string type) => type switch
    {
        "Gather" => "collect resources",
        "Kill" => "kill NPCs, animals, Bradley…",
        "Loot" => "open crates",
        "Craft" => "craft items",
        "Deliver" => "bring items to the giver",
        "Swipe" => "open keycard doors",
        "Visit" => "reach a monument",
        _ => "",
    };

    private static string TypeBadge(string type) => type switch
    {
        "Kill" => "bad",
        "Loot" or "Swipe" => "warn",
        "Visit" => "good",
        _ => "rust",
    };

    private static string AmountLabel(string type) => type switch
    {
        "Gather" => "How many",
        "Kill" => "How many kills",
        "Loot" => "How many containers",
        "Craft" => "How many",
        "Deliver" => "How many",
        "Swipe" => "How many doors",
        _ => "Amount",
    };

    private string ObjectiveOf(JsonObject q) =>
        Str(q, QuestsService.ObjectiveKey) is { Length: > 0 } custom ? custom : AutoObjective(q);

    private string AutoObjective(JsonObject q)
    {
        var type = Str(q, QuestsService.TypeKey);
        var target = Str(q, QuestsService.TargetKey);
        var n = ((int)Num(q, QuestsService.AmountKey)).ToString("N0", CultureInfo.InvariantCulture);
        var where = Str(q, QuestsService.WhereKey) is { Length: > 0 } w ? $" at {w}" : "";
        string Items() => string.Join(" or ", target.Split(',').Select(s => NameOf(s.Trim())).Where(s => s.Length > 0));
        string Preset((string Label, string Target)[] list, string custom) =>
            list.FirstOrDefault(p => p.Target == target).Label is { } l ? QuestsService.Noun(l) : custom;
        return type switch
        {
            "Gather" => $"Gather {n} {Items()}{where}",
            "Kill" => $"Kill {n} {Preset(QuestsService.KillPresets, target)}{where}",
            "Loot" => $"Loot {n} {Preset(QuestsService.LootPresets, target.Contains(',') ? "containers" : target)}{where}",
            "Craft" => $"Craft {n} {Items()}",
            "Deliver" => $"Bring {n} {Items()} to {GiverLabel(q) ?? "a quest giver"}",
            "Swipe" => n == "1" ? $"Open a {(target == "any" ? "" : target + " ")}keycard door{where}" : $"Open {n} {(target == "any" ? "" : target + " ")}keycard doors{where}",
            "Visit" => $"Visit {target}",
            _ => $"{type} {n} {target}",
        };
    }

    private string NameOf(string shortName) => _itemsByShort.TryGetValue(shortName, out var i) ? i.Name : shortName;
    private bool Known(string shortName) => _itemsByShort.Count == 0 || _itemsByShort.ContainsKey(shortName);

    private static string Str(JsonObject o, string key) => o[key] is JsonValue v && v.TryGetValue<string>(out var s) ? s : "";

    private static bool Bool(JsonObject o, string key, bool fallback = false) =>
        o[key] is JsonValue v && v.TryGetValue<bool>(out var b) ? b : fallback;

    private static double Num(JsonObject o, string key)
    {
        if (o[key] is not JsonValue v) return 0;
        if (v.TryGetValue<double>(out var d)) return d;
        if (v.TryGetValue<int>(out var i)) return i;
        if (v.TryGetValue<long>(out var l)) return l;
        if (v.TryGetValue<float>(out var f)) return f;
        return 0;
    }

    private void Set(JsonObject o, string key, string value)
    {
        o[key] = value;
        _dirty = true;
    }

    private void SetStr(JsonObject o, string key, ChangeEventArgs e) => Set(o, key, e.Value?.ToString()?.Trim() ?? "");

    private void SetBool(JsonObject o, string key, ChangeEventArgs e)
    {
        o[key] = e.Value is true;
        _dirty = true;
    }

    private void SetNum(JsonObject o, string key, ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) || v < 0) return;
        o[key] = Math.Round(v, 2);
        _dirty = true;
    }

    private void SetInt(JsonObject o, string key, ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) || v < 1) return;
        o[key] = (int)Math.Round(v);
        _dirty = true;
    }

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
