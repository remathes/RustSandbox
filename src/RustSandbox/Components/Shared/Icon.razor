            <g><path d="M6 3.5h10.5a2 2 0 0 1 2 2V18a2.5 2.5 0 0 1-2.5 2.5H7.5A2.5 2.5 0 0 1 5 18V5a1.5 1.5 0 0 1 1-1.5Z" /><path d="M9 8h6" /><path d="M9 12h6" /><path d="M9 16h3" /></g>
